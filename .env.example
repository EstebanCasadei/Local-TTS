# Firebase — without these, the app runs 100% local (no network calls).
# Get them from Firebase Console → Project Settings → General → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# GlitchTip error tracking — build-time only (NOT exposed to the client).
# Set these to enable source-map upload during `pnpm build`. Without them,
# no source maps are generated and error stack traces stay minified.
# Auth token: GlitchTip → Profile → Auth Tokens.
# Org/project slugs: GlitchTip API → GET /api/0/projects/ (slugs ≠ display names).
SENTRY_URL=https://app.glitchtip.com
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
