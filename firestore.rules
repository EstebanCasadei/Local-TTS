rules_version = '2';

// Each user can only read and write within their own subtree.
// The {resto=**} wildcard covers books, chunks, and progress without repeating
// rules per collection: nothing under users/{uid} is accessible with a different
// uid, and nothing outside users/ is accessible at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{resto=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
