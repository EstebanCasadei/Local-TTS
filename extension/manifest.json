{
  "manifest_version": 3,
  "name": "LocalTTS · Lectura web",
  "version": "0.1.0",
  "description": "Escucha el texto seleccionado con voces locales, una cola de lectura y resaltado en la página.",
  "minimum_chrome_version": "123",
  "permissions": ["contextMenus", "sidePanel", "activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Abrir LocalTTS",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "extension/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
